#!/bin/bash

source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

#=================================================
# CONSISTENT DATABASE COPY
#=================================================

# YunoHost copies the files after this script, while Flowplan keeps running.
# The live SQLite file (with its write-ahead log) may change during that
# copy, so a consistent snapshot is made first with SQLite's online backup;
# the restore puts it in place of the live file.
if [ -f "$data_dir/flowplan.sqlite" ]; then
    ynh_print_info "Taking a consistent snapshot of the database..."
    rm -f "$data_dir/flowplan-backup.sqlite"
    ynh_exec_as_app sqlite3 "$data_dir/flowplan.sqlite" ".timeout 30000" ".backup '$data_dir/flowplan-backup.sqlite'"
fi

#=================================================
# DECLARE DATA AND CONF FILES TO BACKUP
#=================================================
ynh_print_info "Declaring files to be backed up..."

ynh_backup "$install_dir"

# Documents, uploads, the database snapshot and the instance's keys.
ynh_backup "$data_dir"

ynh_backup "/etc/nginx/conf.d/$domain.d/$app.conf"
ynh_backup "/etc/systemd/system/$app.service"
ynh_backup "/etc/logrotate.d/$app"
ynh_backup "/var/log/$app/"

ynh_print_info "Backup script completed for $app. (YunoHost will then actually copy those files to the archive)."
