#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# APP SETTINGS
#=================================================

# Only this token creates the first account on Flowplan's setup screen. With
# the YunoHost sign-in (LDAP / portal) nobody needs it; it keeps strangers
# from claiming the instance while it is public.
setup_token=$(ynh_string_random --length=32)
ynh_app_setting_set --key=setup_token --value="$setup_token"

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

ynh_setup_source --dest_dir="$install_dir"
chown -R "$app:www-data" "$install_dir"
chmod -R o-rwx "$install_dir"

#=================================================
# APP INITIAL CONFIGURATION
#=================================================
ynh_script_progression "Adding $app's configuration..."

flowplan_write_env
chown -R "$app:$app" "$data_dir"
chmod 750 "$data_dir"

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

ynh_config_add_nginx
ynh_config_add_systemd
yunohost service add "$app" --description="Flowplan: documents, databases, whiteboards and a journal" --log="/var/log/$app/$app.log"
ynh_config_add_logrotate

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start"
flowplan_wait_until_ready

ynh_script_progression "Installation of $app completed"
