# Flowplan's settings for this YunoHost app (written by the package on
# install and upgrade – changes here are overwritten; see doc/ADMIN.md).
# All variables: https://docs.flowplan.org/en/environment-variables
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
HOSTNAME=127.0.0.1
PORT=__PORT__
APP_URL=https://__DOMAIN__
FLOWPLAN_DATA_DIR=__DATA_DIR__
# nginx is the one proxy in front of Flowplan.
FLOWPLAN_TRUSTED_PROXIES=1
# The first account on the setup screen only with this token (see the admin doc).
FLOWPLAN_SETUP_TOKEN=__SETUP_TOKEN__

# Sign-in with the YunoHost account: YunoHost's own LDAP directory, only for
# people with the permission for this app; members of the YunoHost group
# "admins" administer Flowplan.
LDAP_URL=ldap://127.0.0.1:389
LDAP_BASE_DN=ou=users,dc=yunohost,dc=org
LDAP_USER_FILTER=(&(objectClass=posixAccount)(|(uid={user})(mail={user}))(permission=cn=__APP__.main,ou=permission,dc=yunohost,dc=org))
LDAP_GROUP_ATTRIBUTE=memberOf
OIDC_ADMIN_GROUP=admins

# Automatic sign-in for whoever is logged in on the YunoHost portal: SSOwat
# sets these headers (and removes them from what a browser sends), nginx
# passes them on (conf/nginx.conf). Only nginx on this machine is trusted.
AUTH_PROXY_USER_HEADER=Ynh-User
AUTH_PROXY_EMAIL_HEADER=Ynh-User-Email
AUTH_PROXY_NAME_HEADER=Ynh-User-Fullname
AUTH_PROXY_TRUSTED_PROXIES=127.0.0.1,::1
AUTH_PROXY_NAME=YunoHost
AUTH_PROXY_LOGIN_URL=https://__DOMAIN__/yunohost/sso/?r={return_b64}
AUTH_PROXY_LOGOUT_URL=https://__DOMAIN__/yunohost/sso/?action=logout

# E-mail through YunoHost's Postfix with the app's own mail account.
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_USER=__APP__
SMTP_PASSWORD=__MAIL_PWD__
SMTP_FROM=Flowplan <__APP__@__DOMAIN__>
SMTP_TLS_SERVERNAME=__MAIN_DOMAIN__
